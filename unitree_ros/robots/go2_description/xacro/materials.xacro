<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- 添加包含保护，确保只加载一次 -->
  <xacro:property name="MATERIALS_XACRO_INCLUDED" value="false"/>

  <xacro:unless value="${MATERIALS_XACRO_INCLUDED}">
    <xacro:property name="MATERIALS_XACRO_INCLUDED" value="true"/>
    
    <!-- 原始材料定义 -->
    <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>
    </material>

    <material name="blue">
      <color rgba="0.0 0.0 0.8 1.0"/>
    </material>

    <material name="green">
      <color rgba="0.0 0.8 0.0 1.0"/>
    </material>

    <material name="grey">
      <color rgba="0.2 0.2 0.2 0.0"/>
    </material>

    <material name="silver">
      <color rgba="${233/255} ${233/255} ${216/255} 1.0"/>
    </material>

    <material name="orange">
      <color rgba="${255/255} ${108/255} ${10/255} 1.0"/>
    </material>

    <material name="brown">
      <color rgba="${222/255} ${207/255} ${195/255} 1.0"/>
    </material>

    <material name="red">
      <color rgba="0.8 0.0 0.0 1.0"/>
    </material>

    <material name="white">
      <color rgba="1.0 1.0 1.0 1.0"/>
    </material>
  </xacro:unless>
</robot>